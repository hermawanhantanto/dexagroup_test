generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  EMPLOYEE
  HR_ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  SICK
  LEAVE
  ABSENT
}

model User {
  id          String    @id @default(uuid())

  email       String    @unique
  password    String
  refreshToken String?  @map("refresh_token") @db.Text

  firstName   String    @map("first_name")
  lastName    String?   @map("last_name")
  position    String?
  department  String?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      Gender?
  role        Role      @default(EMPLOYEE)
  salary      Decimal?  @db.Decimal(12, 2)
  joinDate    DateTime? @map("join_date") @db.Date

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  attendances Attendance[]

  @@map("users")
}

model Attendance {
  id             String           @id @default(uuid())

  userId         String           @map("user_id")

  attendanceDate DateTime         @map("attendance_date") @db.Date
  clockInAt      DateTime?        @map("clock_in_at")
  clockOutAt     DateTime?        @map("clock_out_at")
  proofImageUrl  String?          @map("proof_image_url") @db.Text
  notes          String?          @db.Text
  status         AttendanceStatus @default(PRESENT)

  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attendanceDate], name: "unique_user_attendance_per_date")
  @@map("attendances")
}

model Holiday {
  id          String   @id @default(uuid())

  holidayDate DateTime @unique @map("holiday_date") @db.Date
  name        String
  description String?  @db.Text

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("holidays")
}
